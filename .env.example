# Copy to .env and fill in. Never commit .env.

# Upstox Developer API (https://upstox.com/developer/api-documentation/)
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://127.0.0.1:8000/auth/upstox/callback
# Optional. Leave empty and use the "Login with Upstox" button on the market page instead.
# (Tokens expire every day at 3:30 AM IST.)
UPSTOX_ACCESS_TOKEN=

# FRED (https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# Backend
DATABASE_URL=sqlite:///./backend/data/portal.db
FRONTEND_ORIGIN=http://localhost:3000

# Frontend (read by Next.js)
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
